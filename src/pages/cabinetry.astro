---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Cabinetry | Snitz Creek Cabinet Shop">
  <Header />
  <main class="pt-24">
    <section class="py-16 max-w-5xl mx-auto px-6">
      <p class="text-wood text-sm uppercase tracking-[0.3em] mb-4">Cabinetry</p>
      <h1 class="font-serif text-5xl md:text-6xl text-darkwood mb-8">Custom Cabinets Designed for Your Home</h1>
      <p class="text-xl text-charcoal/70 max-w-3xl leading-relaxed">Framed or frameless. Traditional or contemporary. Our designers work with you to create cabinetry that fits your style, storage needs, and the way you live.</p>
    </section>

    <section class="pb-20 max-w-5xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="font-serif text-3xl text-darkwood mb-4">Styles & Construction</h2>
        <ul class="space-y-3 text-charcoal/80">
          <li>• Framed and frameless construction</li>
          <li>• Inset, full overlay, and traditional face frames</li>
          <li>• Solid wood doors and drawers</li>
          <li>• Custom finishes, stains, and painted options</li>
          <li>• Soft-close hardware and thoughtful storage solutions</li>
        </ul>
      </div>
      <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=1200&q=80" alt="Custom kitchen cabinetry" class="w-full aspect-[4/5] object-cover" />
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-5xl mx-auto px-6">
        <h2 class="font-serif text-3xl text-darkwood mb-8">Wood Species</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
          <div class="border border-wood/20 p-4 text-center">Alder</div>
          <div class="border border-wood/20 p-4 text-center">Cherry</div>
          <div class="border border-wood/20 p-4 text-center">Maple</div>
          <div class="border border-wood/20 p-4 text-center">Oak</div>
          <div class="border border-wood/20 p-4 text-center">Walnut</div>
          <div class="border border-wood/20 p-4 text-center">Hickory</div>
          <div class="border border-wood/20 p-4 text-center">Butternut</div>
          <div class="border border-wood/20 p-4 text-center">Paint-Grade Maple</div>
        </div>
        <p class="mt-6 text-charcoal/60 text-sm">Plus additional species and custom options available. Visit the showroom to see samples.</p>
      </div>
    </section>

    <section class="py-20 text-center">
      <a href="/contact" class="inline-block bg-darkwood text-cream px-10 py-4 text-sm uppercase tracking-widest hover:bg-wood transition">Schedule a Design Consultation</a>
    </section>
  </main>
  <Footer />
</Layout>
