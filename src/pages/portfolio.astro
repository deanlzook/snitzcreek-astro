---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const collections = [
  {
    title: "High Gloss Modern Kitchen",
    images: [
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-1-1.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-2.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-4.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-5.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-7.jpg",
    ]
  },
  {
    title: "Traditional Inset Frame Cabinets",
    images: [
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-3.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-22.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-20.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-19.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-18.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-17.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-16.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-2.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-10.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-14.jpg",
    ]
  },
  {
    title: "Traditional Shaker Style Kitchen",
    images: [
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-2.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-7.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-8.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-9.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-11.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-0033.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-0039.jpg",
    ]
  },
  {
    title: "Vanities",
    images: [
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-20.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Fetrow-6-2-scaled-1.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/IMG_5038-scaled-1.jpg",
    ]
  }
];
---

<Layout title="Portfolio | Snitz Creek Cabinet Shop">
  <Header />
  <main class="pt-24">
    <section class="py-16 max-w-5xl mx-auto px-6 text-center">
      <p class="text-wood text-sm uppercase tracking-[0.3em] mb-4">Portfolio</p>
      <h1 class="font-serif text-5xl md:text-6xl text-darkwood mb-6">Our Work</h1>
      <p class="text-xl text-charcoal/70 max-w-2xl mx-auto">A selection of kitchens, baths, and custom cabinetry projects. Each piece is designed and built for the people who live with it.</p>
    </section>

    <!-- Collections -->
    <section class="pb-24 max-w-7xl mx-auto px-6 space-y-20">
      {collections.map((collection, colIndex) => (
        <div>
          <h2 class="font-serif text-3xl md:text-4xl text-darkwood mb-8">{collection.title}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
            {collection.images.map((src, imgIndex) => (
              <button
                type="button"
                class="group relative overflow-hidden aspect-[4/5] cursor-pointer"
                data-col={colIndex}
                data-img={imgIndex}
                onclick={`openLightbox(${colIndex}, ${imgIndex})`}
              >
                <img src={src} alt={collection.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
                  <p class="text-cream font-serif text-xl">{collection.title}</p>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="py-16 bg-darkwood text-cream text-center">
      <h2 class="font-serif text-3xl md:text-4xl mb-4">Ready to start your own project?</h2>
      <a href="/contact" class="inline-block mt-6 bg-gold text-charcoal px-10 py-4 text-sm uppercase tracking-widest font-medium hover:bg-cream transition">Contact Us</a>
    </section>
  </main>
  <Footer />

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-black/95 hidden items-center justify-center">
    <button onclick="closeLightbox()" class="absolute top-6 right-6 text-cream text-3xl hover:text-gold">&times;</button>
    <button onclick="prevImage()" class="absolute left-6 text-cream text-4xl hover:text-gold">&lsaquo;</button>
    <button onclick="nextImage()" class="absolute right-6 text-cream text-4xl hover:text-gold">&rsaquo;</button>
    <img id="lightbox-img" class="max-h-[85vh] max-w-[90vw] object-contain" />
    <p id="lightbox-caption" class="absolute bottom-8 text-cream font-serif text-xl"></p>
  </div>

  <script>
    const collections = [
      {
        title: "High Gloss Modern Kitchen",
        images: [
          "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-1-1.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-2.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-4.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-5.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-7.jpg",
        ]
      },
      {
        title: "Traditional Inset Frame Cabinets",
        images: [
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-3.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-22.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-20.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-19.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-18.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-17.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-16.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-2.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-10.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-14.jpg",
        ]
      },
      {
        title: "Traditional Shaker Style Kitchen",
        images: [
          "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-2.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-7.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-8.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-9.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-11.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-0033.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-0039.jpg",
        ]
      },
      {
        title: "Vanities",
        images: [
          "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-20.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/Fetrow-6-2-scaled-1.jpg",
          "https://snitzcreek.com/wp-content/uploads/2023/03/IMG_5038-scaled-1.jpg",
        ]
      }
    ];

    let currentCol = 0;
    let currentImg = 0;

    function openLightbox(col, img) {
      currentCol = col;
      currentImg = img;
      updateLightbox();
      document.getElementById('lightbox').classList.remove('hidden');
      document.getElementById('lightbox').classList.add('flex');
    }

    function closeLightbox() {
      document.getElementById('lightbox').classList.add('hidden');
      document.getElementById('lightbox').classList.remove('flex');
    }

    function nextImage() {
      const len = collections[currentCol].images.length;
      currentImg = (currentImg + 1) % len;
      updateLightbox();
    }

    function prevImage() {
      const len = collections[currentCol].images.length;
      currentImg = (currentImg - 1 + len) % len;
      updateLightbox();
    }

    function updateLightbox() {
      const col = collections[currentCol];
      document.getElementById('lightbox-img').src = col.images[currentImg];
      document.getElementById('lightbox-caption').textContent = col.title;
    }

    // Keyboard support
    document.addEventListener('keydown', (e) => {
      const lb = document.getElementById('lightbox');
      if (lb.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    });

    // Expose for onclick
    window.openLightbox = openLightbox;
    window.closeLightbox = closeLightbox;
    window.nextImage = nextImage;
    window.prevImage = prevImage;
  </script>
</Layout>
