---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const collections = [
  {
    title: "High Gloss Modern Kitchen",
    images: [
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-1-1.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-2.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-4.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-5.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-7.jpg",
    ]
  },
  {
    title: "Traditional Inset Frame Cabinets",
    images: [
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-3.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-22.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-20.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-19.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-18.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-17.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-16.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-2.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-10.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-14.jpg",
    ]
  },
  {
    title: "Traditional Shaker Style Kitchen",
    images: [
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-2.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-7.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-8.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-9.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-11.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-0033.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-0039.jpg",
    ]
  },
  {
    title: "Vanities",
    images: [
      "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-20.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/Fetrow-6-2-scaled-1.jpg",
      "https://snitzcreek.com/wp-content/uploads/2023/03/IMG_5038-scaled-1.jpg",
    ]
  }
];

const instagramImages = [
  "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-1-1.jpg",
  "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-3.jpg",
  "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-.jpg",
  "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-2.jpg",
  "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-22.jpg",
  "https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-2.jpg",
  "https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-4.jpg",
  "https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-20.jpg",
];
---

<Layout title="Portfolio | Snitz Creek Cabinet Shop">
  <Header />
  <main class="pt-24">
    <section class="py-16 max-w-5xl mx-auto px-6 text-center">
      <p class="text-wood text-sm uppercase tracking-[0.3em] mb-4">Portfolio</p>
      <h1 class="font-serif text-5xl md:text-6xl text-darkwood mb-6">Our Work</h1>
      <p class="text-xl text-charcoal/70 max-w-2xl mx-auto">A selection of kitchens, baths, and custom cabinetry projects. Each piece is designed and built for the people who live with it.</p>
    </section>

    <!-- Collections as Carousels -->
    <section class="pb-24 max-w-7xl mx-auto px-6 space-y-24">
      {collections.map((collection, colIndex) => (
        <div class="collection-carousel" data-collection={colIndex}>
          <h2 class="font-serif text-3xl md:text-4xl text-darkwood mb-8">{collection.title}</h2>
          
          <div class="collection-frame relative flex items-center justify-center bg-cream min-h-[400px] max-h-[80vh] overflow-hidden transition-all duration-500">
            {collection.images.map((src, imgIndex) => (
              <img
                src={src}
                alt={collection.title}
                class={`collection-slide absolute max-w-full max-h-[80vh] w-auto h-auto object-contain transition-opacity duration-1000 ${imgIndex === 0 ? 'opacity-100' : 'opacity-0'}`}
                data-collection={colIndex}
                data-index={imgIndex}
              />
            ))}
          </div>

          <!-- Dots -->
          <div class="flex justify-center gap-3 mt-6">
            {collection.images.map((_, imgIndex) => (
              <button
                type="button"
                class={`collection-dot w-3 h-3 rounded-full transition ${imgIndex === 0 ? 'bg-gold' : 'bg-wood/30'}`}
                data-collection={colIndex}
                data-index={imgIndex}
                aria-label={`Go to photo ${imgIndex + 1}`}
              ></button>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- Follow Us on Instagram -->
    <section class="py-20 bg-cream border-t border-wood/20">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center mb-10">
          <h2 class="font-serif text-3xl md:text-4xl text-darkwood mb-4">Follow Us on Instagram</h2>
          <p class="text-charcoal/70">See more of our work and behind-the-scenes moments</p>
          <a href="https://www.instagram.com/snitzcreekcabinetshop/" target="_blank" rel="noopener" class="inline-block mt-4 text-wood hover:text-darkwood text-lg font-medium">@snitzcreekcabinetshop</a>
        </div>

        <div class="relative">
          <button type="button" class="insta-prev absolute left-0 top-1/2 -translate-y-1/2 z-10 w-10 h-16 bg-cream/90 hover:bg-gold text-darkwood flex items-center justify-center rounded-r shadow-md transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>

          <div class="instagram-scroll flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory" style="scrollbar-width: none; -ms-overflow-style: none;">
            {instagramImages.map((src) => (
              <a 
                href="https://www.instagram.com/snitzcreekcabinetshop/" 
                target="_blank" 
                rel="noopener"
                class="flex-shrink-0 snap-center"
              >
                <img 
                  src={src} 
                  alt="Snitz Creek on Instagram" 
                  class="h-64 w-auto object-cover rounded hover:opacity-90 transition"
                />
              </a>
            ))}
          </div>

          <button type="button" class="insta-next absolute right-0 top-1/2 -translate-y-1/2 z-10 w-10 h-16 bg-cream/90 hover:bg-gold text-darkwood flex items-center justify-center rounded-l shadow-md transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </section>

    <section class="py-16 bg-darkwood text-cream text-center">
      <h2 class="font-serif text-3xl md:text-4xl mb-4">Ready to start your own project?</h2>
      <a href="/contact" class="inline-block mt-6 bg-gold text-charcoal px-10 py-4 text-sm uppercase tracking-widest font-medium hover:bg-cream transition">Contact Us</a>
    </section>
  </main>
  <Footer />

  <style>
    .instagram-scroll::-webkit-scrollbar {
      display: none;
    }
  </style>

  <script>
    const carousels = document.querySelectorAll('.collection-carousel');

    carousels.forEach((carousel) => {
      const colIndex = carousel.dataset.collection;
      const frame = carousel.querySelector('.collection-frame');
      const slides = carousel.querySelectorAll(`.collection-slide[data-collection="${colIndex}"]`);
      const dots = carousel.querySelectorAll(`.collection-dot[data-collection="${colIndex}"]`);
      let current = 0;
      const total = slides.length;
      let timer = null;
      let isHovered = false;

      function showSlide(index) {
        slides.forEach((slide, i) => {
          slide.classList.toggle('opacity-100', i === index);
          slide.classList.toggle('opacity-0', i !== index);
          slide.classList.toggle('pointer-events-none', i !== index);
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-gold', i === index);
          dot.classList.toggle('bg-wood/30', i !== index);
        });

        const activeImg = slides[index];
        if (activeImg.complete && activeImg.naturalHeight) {
          const ratio = activeImg.naturalHeight / activeImg.naturalWidth;
          const width = frame.clientWidth;
          const height = Math.min(width * ratio, window.innerHeight * 0.8);
          frame.style.height = height + 'px';
        } else {
          activeImg.onload = () => {
            const ratio = activeImg.naturalHeight / activeImg.naturalWidth;
            const width = frame.clientWidth;
            const height = Math.min(width * ratio, window.innerHeight * 0.8);
            frame.style.height = height + 'px';
          };
        }

        current = index;
      }

      function nextSlide() {
        showSlide((current + 1) % total);
      }

      function startTimer() {
        if (timer) clearInterval(timer);
        timer = setInterval(nextSlide, 6000);
      }

      function stopTimer() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      showSlide(0);

      carousel.addEventListener('mouseenter', () => {
        isHovered = true;
        startTimer();
      });

      carousel.addEventListener('mouseleave', () => {
        isHovered = false;
        stopTimer();
      });

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          showSlide(i);
          if (isHovered) {
            stopTimer();
            startTimer();
          }
        });
      });

      window.addEventListener('resize', () => showSlide(current));
    });

    // Instagram scroll with arrows
    const instaScroll = document.querySelector('.instagram-scroll');
    const prevBtn = document.querySelector('.insta-prev');
    const nextBtn = document.querySelector('.insta-next');

    if (instaScroll && prevBtn && nextBtn) {
      const scrollStep = 300;

      prevBtn.addEventListener('click', () => {
        instaScroll.scrollBy({ left: -scrollStep, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        instaScroll.scrollBy({ left: scrollStep, behavior: 'smooth' });
      });
    }
  </script>
</Layout>
