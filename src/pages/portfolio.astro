---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Portfolio | Snitz Creek Cabinet Shop">
  <Header />
  <main class="pt-24">
    <section class="py-16 max-w-5xl mx-auto px-6 text-center">
      <p class="text-wood text-sm uppercase tracking-[0.3em] mb-4">Portfolio</p>
      <h1 class="font-serif text-5xl md:text-6xl text-darkwood mb-6">Our Work</h1>
      <p class="text-xl text-charcoal/70 max-w-2xl mx-auto">A selection of kitchens, baths, and custom cabinetry projects. Each piece is designed and built for the people who live with it.</p>
    </section>

    <!-- Gallery Grid -->
    <section class="pb-24 max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=1200&q=80" alt="Traditional kitchen cabinetry" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Traditional Kitchen</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://images.unsplash.com/photo-1556911220-bff31c812dba?auto=format&fit=crop&w=1200&q=80" alt="Custom island cabinetry" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Custom Island</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=1200&q=80" alt="Modern wood cabinetry" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Warm Wood Finish</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://images.unsplash.com/photo-1616594039964-ae9021a400a0?auto=format&fit=crop&w=1200&q=80" alt="Kitchen storage solutions" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Thoughtful Storage</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://images.unsplash.com/photo-1556911220-e15b29be8c8f?auto=format&fit=crop&w=1200&q=80" alt="Painted cabinetry" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Painted Finish</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=1200&q=80" alt="Luxury kitchen" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Full Kitchen Remodel</p>
          </div>
        </div>
      </div>

      <p class="text-center text-charcoal/50 text-sm mt-12">Placeholder images for now. We can replace these with your actual project photos anytime.</p>
    </section>

    <section class="py-16 bg-darkwood text-cream text-center">
      <h2 class="font-serif text-3xl md:text-4xl mb-4">Ready to start your own project?</h2>
      <a href="/contact" class="inline-block mt-6 bg-gold text-charcoal px-10 py-4 text-sm uppercase tracking-widest font-medium hover:bg-cream transition">Contact Us</a>
    </section>
  </main>
  <Footer />
</Layout>
