---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Portfolio | Snitz Creek Cabinet Shop">
  <Header />
  <main class="pt-24">
    <section class="py-16 max-w-5xl mx-auto px-6 text-center">
      <p class="text-wood text-sm uppercase tracking-[0.3em] mb-4">Portfolio</p>
      <h1 class="font-serif text-5xl md:text-6xl text-darkwood mb-6">Our Work</h1>
      <p class="text-xl text-charcoal/70 max-w-2xl mx-auto">A selection of kitchens, baths, and custom cabinetry projects. Each piece is designed and built for the people who live with it.</p>
    </section>

    <!-- Gallery Grid -->
    <section class="pb-24 max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-1-1.jpg" alt="High Gloss Modern Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">High Gloss Modern Kitchen</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-4.jpg" alt="High Gloss Modern Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">High Gloss Modern Kitchen</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-3.jpg" alt="Traditional Inset Frame Cabinets" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Traditional Inset Frame Cabinets</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-22.jpg" alt="Traditional Inset Frame Cabinets" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Traditional Inset Frame Cabinets</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-.jpg" alt="Traditional Shaker Style Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Traditional Shaker Style Kitchen</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-9.jpg" alt="Traditional Shaker Style Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Traditional Shaker Style Kitchen</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/Giannini-20.jpg" alt="Vanities" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Vanities</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/modern-kitchen-5.jpg" alt="High Gloss Modern Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">High Gloss Modern Kitchen</p>
          </div>
        </div>
        <div class="group relative overflow-hidden aspect-[4/5]">
          <img src="https://snitzcreek.com/wp-content/uploads/2023/03/Lynn-Reisinger-2.jpg" alt="Traditional Shaker Style Kitchen" class="w-full h-full object-cover group-hover:scale-105 transition duration-700" />
          <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end p-6">
            <p class="text-cream font-serif text-xl">Traditional Shaker Style Kitchen</p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 bg-darkwood text-cream text-center">
      <h2 class="font-serif text-3xl md:text-4xl mb-4">Ready to start your own project?</h2>
      <a href="/contact" class="inline-block mt-6 bg-gold text-charcoal px-10 py-4 text-sm uppercase tracking-widest font-medium hover:bg-cream transition">Contact Us</a>
    </section>
  </main>
  <Footer />
</Layout>
