---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact | Snitz Creek Cabinet Shop">
  <Header />
  <main class="pt-24">
    <section class="py-20 max-w-5xl mx-auto px-6">
      <h1 class="font-serif text-5xl text-darkwood mb-4">Start a Project</h1>
      <p class="text-lg text-charcoal/70 mb-12">We’d love to help you create cabinetry that fits your home and your life. Visit the showroom or get in touch.</p>

      <div class="grid md:grid-cols-2 gap-12 mb-16">
        <div>
          <h2 class="font-serif text-2xl mb-4">Showroom</h2>
          <p class="leading-relaxed">2020 Cornwall Road<br>Lebanon, PA 17042</p>
          <p class="mt-4 text-sm text-charcoal/70">Monday – Friday<br>8:00 am – 5:00 pm</p>
        </div>
        <div>
          <h2 class="font-serif text-2xl mb-4">Get in Touch</h2>
          <p><a href="tel:7172739861" class="text-wood hover:text-darkwood">(717) 273-9861</a></p>
          <p class="mt-2"><a href="mailto:info@snitzcreek.com" class="text-wood hover:text-darkwood">info@snitzcreek.com</a></p>
        </div>
      </div>

      <!-- Map -->
      <div class="mb-16 rounded-lg overflow-hidden shadow-sm border border-wood/10">
        <iframe
          src="https://maps.google.com/maps?q=2020%20Cornwall%20Road%20Lebanon%20PA%2017042&t=&z=15&ie=UTF8&iwloc=&output=embed"
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Snitz Creek Cabinet Shop location"
        ></iframe>
        <div class="bg-cream px-4 py-3 text-sm text-charcoal/70 text-center">
          <a href="https://www.google.com/maps/search/?api=1&query=2020+Cornwall+Road+Lebanon+PA+17042" target="_blank" rel="noopener" class="hover:text-wood">Open in Google Maps →</a>
        </div>
      </div>

      <form action="https://api.web3forms.com/submit" method="POST" class="space-y-6">
        <input type="hidden" name="access_key" value="37fc4beb-c0d7-470b-8bb5-9651e2428b6c" />
        <input type="hidden" name="subject" value="New project inquiry from snitzcreek.com" />
        <input type="hidden" name="from_name" value="Snitz Creek Contact Form" />
        
        <div class="grid md:grid-cols-2 gap-6">
          <input type="text" name="name" placeholder="Name" required class="w-full border border-wood/30 bg-white px-4 py-3 focus:outline-none focus:border-wood" />
          <input type="email" name="email" placeholder="Email" required class="w-full border border-wood/30 bg-white px-4 py-3 focus:outline-none focus:border-wood" />
        </div>
        <input type="tel" name="phone" placeholder="Phone" class="w-full border border-wood/30 bg-white px-4 py-3 focus:outline-none focus:border-wood" />
        <textarea name="message" rows="5" placeholder="Tell us about your project" required class="w-full border border-wood/30 bg-white px-4 py-3 focus:outline-none focus:border-wood"></textarea>
        
        <button type="submit" class="bg-darkwood text-cream px-10 py-4 text-sm uppercase tracking-widest hover:bg-wood transition">Send Message</button>
      </form>
    </section>
  </main>
  <Footer />
</Layout>
